# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ (.env ห้าม commit)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=corporate_events
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ชื่อ Google Sheet ที่สร้างไว้และแชร์ให้ Service Account เป็น Editor
GOOGLE_SHEET_NAME=corporate_events_dashboard
GOOGLE_CREDENTIALS_FILE=credentials.json

# (ไม่บังคับ) เปลี่ยนที่อยู่ไฟล์ CSV
# CSV_PATH=data/corporate_events_clean.csv
